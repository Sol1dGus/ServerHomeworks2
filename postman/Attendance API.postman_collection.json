  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// базовая проверка стандарта ответа",
          "if (pm.response.code !== 204) {",
          "  pm.test('success=true в ответе', function () {",
          "    const json = pm.response.json();",
          "    pm.expect(json).to.have.property('success');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Groups",
      "item": [
        {
          "name": "Get all groups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Request-Id", "value": "{{requestId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/groups", "host": ["{{baseUrl}}"], "path": ["api", "groups"] }
          }
        },
        {
          "name": "Get group by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Request-Id", "value": "{{requestId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["api", "groups", "{{groupId}}"] }
          }
        },
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "{{requestId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"IU-7A\"\r\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/groups", "host": ["{{baseUrl}}"], "path": ["api", "groups"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.data && json.data.id) pm.collectionVariables.set('groupId', String(json.data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update group",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "{{requestId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"IU-7A (updated)\"\r\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["api", "groups", "{{groupId}}"] }
          }
        },
        {
          "name": "Delete group",
